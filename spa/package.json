{
  "name": "sandbox",
  "version": "0.0.0",
  "description": "SIPS app",
  "author": "Nazaries IT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prettier": "prettier --write src",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "apigen": "./node_modules/yasag/dist/index.js -d src/api -s swagger.json -b -h -r _data",
    "geogen": "yasag -d src/api -s georest.json -d src/geo -b -v geoUrl",
    "postinstall": "ln -s $PWD/'node_modules/@hanreev/types-ol/ol' './node_modules/@types/ol'",
    "preinstall": "[ -L './node_modules/@types/ol' ] && rm './node_modules/@types/ol' || true",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
